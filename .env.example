# Environment Variables for ORBIT

# Database (PostgreSQL via Neon, Supabase, or Local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/orbit_db?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="orbit_rvce_secure_nextauth_development_secret_32bytes"

# Google OAuth Credentials (RVCE Google Workspace)
# Obtain from https://console.cloud.google.com
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Development Quick-Login Mode (true enables simulated RVCE logins without Google Cloud credentials)
ENABLE_DEV_LOGIN="true"

# Resend API Key for Transactional Opportunity Reminders
RESEND_API_KEY="re_placeholder_key"
EMAIL_FROM="ORBIT Notifications <notifications@orbit-rvce.edu.in>"
